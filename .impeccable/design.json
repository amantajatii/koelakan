  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one emerald action per context.",
      "html": "<button class=\"ds-btn-primary\">Sign in with a NEAR wallet</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:12px;background:#0a7f61;color:#fff;font:600 0.875rem/1.35rem Figtree,ui-sans-serif,system-ui,sans-serif;box-shadow:0 1px 2px rgba(8,105,79,0.3);cursor:pointer;transition:background-color 200ms ease-out}.ds-btn-primary:hover{background:#087458}.ds-btn-primary:active{background:#08694f}.ds-btn-primary:focus-visible{outline:3px solid #0a7f61;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet companion action on white.",
      "html": "<button class=\"ds-btn-secondary\">Try again</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border:1px solid #c9d8d1;border-radius:12px;background:#fff;color:#0f2a22;font:600 0.875rem/1.35rem Figtree,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 200ms ease-out,border-color 200ms ease-out}.ds-btn-secondary:hover{background:#e3f4ee;border-color:rgba(10,127,97,0.5)}.ds-btn-secondary:focus-visible{outline:3px solid #0a7f61;outline-offset:2px}"
    },
    {
      "name": "On-brand Button",
      "kind": "button",
      "refersTo": "button-on-brand",
      "description": "White action on the emerald banner and on pastel item cards.",
      "html": "<div class=\"ds-onbrand-wrap\"><button class=\"ds-btn-onbrand\">Round #7 <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button></div>",
      "css": ".ds-onbrand-wrap{background:#08694f;padding:20px;border-radius:20px}.ds-btn-onbrand{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 16px;border:0;border-radius:12px;background:#fff;color:#066049;font:600 0.875rem/1.35rem Figtree,ui-sans-serif,system-ui,sans-serif;box-shadow:0 1px 2px rgba(0,0,0,0.12);cursor:pointer;transition:background-color 200ms ease-out}.ds-btn-onbrand:hover{background:#e3f4ee}.ds-btn-onbrand:focus-visible{outline:3px solid #0a7f61;outline-offset:2px}"
    },
    {
      "name": "Number Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with hint; tabular digits.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-amt\">Withdraw to your wallet (Rp)</label><input id=\"ds-amt\" class=\"ds-input\" inputmode=\"numeric\" placeholder=\"100,000\"><p class=\"ds-field-hint\">Money held in open rounds cannot be withdrawn.</p></div>",
      "css": ".ds-field{font-family:Figtree,ui-sans-serif,system-ui,sans-serif;color:#0f2a22;max-width:320px}.ds-field-label{display:block;margin-bottom:6px;font-size:0.875rem;font-weight:600}.ds-input{width:100%;min-height:44px;padding:0 14px;border:1px solid #c9d8d1;border-radius:12px;background:#fff;color:#0f2a22;font:400 1rem/1.6rem inherit;font-variant-numeric:tabular-nums;transition:border-color 150ms}.ds-input::placeholder{color:#6b7b74}.ds-input:hover{border-color:rgba(10,127,97,0.5)}.ds-input:focus-visible{border-color:#0a7f61;outline:3px solid #0a7f61;outline-offset:0}.ds-field-hint{margin-top:6px;font-size:0.75rem;color:#55665f}"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "chip-good",
      "description": "Dot plus word; colour never alone.",
      "html": "<span class=\"ds-chip ds-chip-good\"><span class=\"ds-chip-dot\"></span>Counts as received</span> <span class=\"ds-chip ds-chip-warn\"><span class=\"ds-chip-dot\"></span>Dispute</span> <span class=\"ds-chip ds-chip-neutral\"><span class=\"ds-chip-dot\"></span>Locked</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:2px 10px;border-radius:9999px;font:600 0.75rem/1.1rem Figtree,ui-sans-serif,system-ui,sans-serif;white-space:nowrap}.ds-chip-dot{width:6px;height:6px;border-radius:9999px;background:currentColor}.ds-chip-good{background:#e3f4ee;color:#066049;box-shadow:inset 0 0 0 1px rgba(10,127,97,0.2)}.ds-chip-good .ds-chip-dot{background:#0a7f61}.ds-chip-warn{background:#fff1d6;color:#8a5a00;box-shadow:inset 0 0 0 1px rgba(138,90,0,0.2)}.ds-chip-neutral{background:#eef6f2;color:#55665f;box-shadow:inset 0 0 0 1px #c9d8d1}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "White card on the mint ground; never nested.",
      "html": "<div class=\"ds-ground\"><section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Next round</h2><p class=\"ds-panel-body\">Rounds open every 60 min. Next round in <span class=\"ds-num\">38:56</span>.</p></section></div>",
      "css": ".ds-ground{background:#eef6f2;padding:24px}.ds-panel{background:#fff;border:1px solid #e3ece8;border-radius:20px;padding:24px;box-shadow:0 1px 2px rgba(15,42,34,0.04),0 8px 24px rgba(15,42,34,0.06);font-family:Figtree,ui-sans-serif,system-ui,sans-serif;color:#0f2a22}.ds-panel-title{margin:0 0 16px;font-size:1.2rem;line-height:1.7rem;font-weight:700;letter-spacing:-0.025em}.ds-panel-body{margin:0;font-size:0.875rem;line-height:1.35rem;color:#55665f}.ds-num{font-variant-numeric:tabular-nums;font-weight:600;color:#0f2a22}"
    },
    {
      "name": "Staple Item Card with Savings Strip",
      "kind": "custom",
      "refersTo": "item-card-rice",
      "description": "Signature: PIHPS struck, paid in emerald, bar of % below PIHPS.",
      "html": "<article class=\"ds-item\"><div class=\"ds-item-head\"><span class=\"ds-item-disc\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 22 16 8\"/><path d=\"M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z\"/><path d=\"M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z\"/><path d=\"M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z\"/></svg></span><div><h3 class=\"ds-item-name\">Medium rice (type II)</h3><p class=\"ds-item-sub\">per kg · HET Rp13,500</p></div></div><div class=\"ds-strip\"><p class=\"ds-strip-row\"><span class=\"ds-strip-ref\">Rp16,650</span><span class=\"ds-strip-paid\">Rp11,924<small>/kg</small></span></p><div class=\"ds-strip-track\"><div class=\"ds-strip-fill\" style=\"width:28.4%\"></div></div><p class=\"ds-strip-pct\">28.4% below PIHPS</p></div></article>",
      "css": ".ds-item{max-width:300px;background:#ffebdd;border-radius:20px;padding:20px;box-shadow:0 1px 2px rgba(15,42,34,0.04),0 8px 24px rgba(15,42,34,0.06),inset 0 0 0 1px rgba(0,0,0,0.04);font-family:Figtree,ui-sans-serif,system-ui,sans-serif;color:#0f2a22}.ds-item-head{display:flex;align-items:center;gap:14px}.ds-item-disc{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:9999px;background:rgba(255,255,255,0.7);color:#9a4a12}.ds-item-name{margin:0;font-size:1.2rem;line-height:1.2;font-weight:700;letter-spacing:-0.025em}.ds-item-sub{margin:2px 0 0;font-size:0.75rem;font-weight:500;color:#9a4a12;font-variant-numeric:tabular-nums}.ds-strip{margin-top:20px}.ds-strip-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:2px 12px;margin:0;font-variant-numeric:tabular-nums}.ds-strip-ref{font-size:0.875rem;color:#9a4a12;text-decoration:line-through;text-decoration-thickness:1px}.ds-strip-paid{font-size:1.44rem;font-weight:800;color:#066049}.ds-strip-paid small{font-size:0.75rem;font-weight:600}.ds-strip-track{margin-top:8px;height:6px;border-radius:9999px;background:rgba(255,255,255,0.7);overflow:hidden}.ds-strip-fill{height:100%;border-radius:9999px;background:#0a7f61;transition:width 500ms ease-out}.ds-strip-pct{margin:6px 0 0;font-size:0.75rem;font-weight:600;color:#066049;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Icon Rail",
      "kind": "nav",
      "refersTo": "nav-rail-item-active",
      "description": "Desktop icon-over-label rail; becomes a bottom tab bar on phones.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail-item\" href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview</a><a class=\"ds-rail-item ds-on\" aria-current=\"page\" href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7\"/><path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"/><path d=\"M2 7h20\"/></svg>My warung</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:6px;width:92px;padding:20px 8px;background:rgba(255,255,255,0.9);border-right:1px solid #e3ece8;font-family:Figtree,ui-sans-serif,system-ui,sans-serif}.ds-rail-item{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 4px;border-radius:16px;font-size:0.72rem;font-weight:600;line-height:1.2;color:#55665f;text-decoration:none;transition:background-color 150ms,color 150ms}.ds-rail-item:hover{background:#eef6f2;color:#0f2a22}.ds-rail-item.ds-on{background:#e3f4ee;color:#066049}.ds-rail-item:focus-visible{outline:3px solid #0a7f61;outline-offset:2px}"
