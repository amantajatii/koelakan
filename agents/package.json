{
  "name": "koelakan-agents",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Live Koelakan agents (warung, grosir, koordinator) for NEAR testnet",
  "scripts": {
    "setup": "tsx src/cli/setup.ts",
    "round": "tsx src/cli/round.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "daemon": "tsx src/cli/daemon.ts",
    "grosir": "tsx src/cli/grosir.ts",
    "keygen:service": "tsx src/cli/keygen-service.ts",
    "pack:secrets": "tsx src/cli/pack-secrets.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/agents/src/cli/daemon.js"
  },
  "dependencies": {
    "near-api-js": "^7.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "borsh": "2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
