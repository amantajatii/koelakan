# Copy to agents/deploy/.env (chmod 600). Never commit .env.

# ---- required
# ed25519 secret key of the delegated-warung service key. Generate with `pnpm keygen:service`.
SERVICE_KEY=
# Public hostname Caddy serves (Let's Encrypt). sslip.io resolves to the VPS IP without owning a domain.
AGENT_DOMAIN=agent.43-157-202-28.sslip.io
# Dashboard origins allowed by CORS (comma list). http://localhost:3000 is always allowed.
ALLOWED_ORIGINS=https://koelakan.vercel.app
# Behind Caddy: trust X-Forwarded-For for the per-IP rate limit.
TRUST_PROXY=true

# ---- cadence (defaults shown)
ROUND_EVERY_MIN=60        # a new round every N minutes; at most one active round per item
JOIN_SECS=300             # each phase 30 s .. 30 d
COMMIT_SECS=90
REVEAL_SECS=90
DELIVERY_SECS=600
MIN_TOTAL_QTY=50          # smallest lot a grosir sells
TICK_SECS=10              # loop period

# ---- simulation shape
SEEDED_JOIN_MIN=6         # sim warungs joining each round: a seeded-random subset of MIN..MAX
SEEDED_JOIN_MAX=9
GROSIR_BIDDERS=3          # how many of grosir-1..5 bid in each round (rotating)
FORGET_PROB=0.15          # chance grosir-5 "forgets" to reveal (bond forfeit path)

# ---- grosir upkeep
WITHDRAW_THRESHOLD=200000 # auto-withdraw a grosir's market balance above this many tIDR
HOUSEKEEP_SECS=120        # balance refresh / withdraw / faucet cadence

# ---- chain and paths (the compose file already sets the paths; change only if you know why)
KOELAKAN_ROOT=koelakan.testnet
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# SERVICE_FC_ALLOWANCE_NEAR=0.25   # shown in /status: allowance the dashboard puts on the service key
# PORT=8787
# DATA_DIR=/data  KEYS_DIR=/secrets/keys  FCK_DIR=/secrets/fck
