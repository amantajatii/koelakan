# All optional. Defaults point at the live Koelakan testnet deployment.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_RPC_FALLBACK_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_MARKET_ID=market.koelakan.testnet
NEXT_PUBLIC_TIDR_ID=tidr.koelakan.testnet
NEXT_PUBLIC_ROOT_ACCOUNT=koelakan.testnet
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
# Agent service HTTP API (status, standing orders). Dashboard degrades gracefully when it is down.
NEXT_PUBLIC_AGENT_API_URL=https://agent.43-157-202-28.sslip.io
# Public URL of this dashboard, used for OG/Twitter tags (set to your Vercel domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development only, leave unset in production: show this account as signed in (screenshots, design review).
# NEXT_PUBLIC_DEV_FIXTURE_ACCOUNT=warung-01.koelakan.testnet
