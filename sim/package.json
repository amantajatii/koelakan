{
  "name": "koelakan-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic TypeScript engine and simulation for the Koelakan market (mirrors contracts/market)",
  "scripts": {
    "simulate": "tsx src/simulate.ts",
    "simulate:json": "tsx src/simulate.ts --json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "golden:gen": "tsx golden/gen.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
